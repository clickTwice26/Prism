# Copy to backend/.env. All values are optional; defaults match docker-compose.

PORT=8080
DATABASE_URL=postgres://prism:prism@localhost:55432/prism?sslmode=disable
REDIS_URL=redis://localhost:56379/0
CORS_ORIGINS=http://localhost:3100

# AI provider: gemini (default) or openai. It powers simplify, the fact check,
# quizzes, translation, image description, pictures and speech. Without a key
# those return 503 and simplify falls back to the offline English rules.
AI_PROVIDER=gemini

# Google Gemini (Interactions API). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
# low keeps answers fast and cheap; leave empty for the model default.
GEMINI_THINKING_LEVEL=low

# OpenAI, used only when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Optional offline read-aloud with Piper (https://github.com/rhasspy/piper).
# Put en_US-lessac-medium.onnx and bn_BD-google-medium.onnx (+ .json) in the dir.
PIPER_BIN=
PIPER_VOICES_DIR=piper_voices

# Per-IP limit on AI endpoints, requests per minute (0 = off).
AI_RATE_LIMIT_PER_MIN=30

# Prism Sign: uploaded sign videos are stored here (keep it on a volume).
SIGN_MEDIA_DIR=media/signs
# Optional: an extracted IsharaKotha corpus. Only its word list is read, to tell
# reviewers when a term already has a documented Bangla Sign Language sign.
SIGN_REFERENCE_DIR=../data/isharakotha/raw/extracted
